@using TheNerdCollective.Blazor.Observability
@using MudBlazor
@implements IDisposable
@inject IObservabilityDashboardService DashboardService

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4" data-testid="observability-dashboard">
    <MudStack Spacing="3">
        <MudStack Spacing="2" Class="observability-dashboard-header">
            <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                <MudStack Spacing="0" Style="flex: 1 1 12rem; min-width: 0;">
                    <MudText Typo="Typo.h4">Observability</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@ResolvedServiceName</MudText>
                </MudStack>

                @if (Overview is not null)
                {
                    <ObservabilityHealthBadge Status="@Overview.Health" />
                }
            </MudStack>

            <MudStack Row="true"
                      Spacing="2"
                      Wrap="Wrap.Wrap"
                      Justify="Justify.FlexEnd"
                      Class="observability-dashboard-actions">
                @if (ShowExternalLink && ExternalUrl is not null)
                {
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Class="observability-dashboard-action"
                               Href="@ExternalUrl.ToString()"
                               Target="_blank"
                               StartIcon="@Icons.Material.Filled.OpenInNew">
                        @ExternalLinkText
                    </MudButton>
                }

                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Class="observability-dashboard-action"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           Disabled="@IsLoading"
                           OnClick="RefreshAsync">
                    Refresh
                </MudButton>
            </MudStack>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <MudAlert Severity="Severity.Error">@ErrorMessage</MudAlert>
        }

        @if (Overview is not null)
        {
            <MudText Typo="Typo.subtitle1">Applikation</MudText>
            <ObservabilityOverviewCards Snapshot="@Overview" />
        }

        <MudGrid>
            <MudItem xs="12" md="6">
                <ObservabilityTimeSeriesChart Title="Request rate"
                                              Series="@RequestRateSeries"
                                              DataTestId="observability-chart-request-rate" />
            </MudItem>

            <MudItem xs="12" md="6">
                <ObservabilityTimeSeriesChart Title="P95 latency"
                                              Series="@P95Series"
                                              DataTestId="observability-chart-p95-latency" />
            </MudItem>
        </MudGrid>

        @if (ShowExtendedPanels)
        {
            <ObservabilityMetricCardRow Title="Host (VM)"
                                        ColumnWidth="4"
                                        Cards="@HostCards" />

            <MudGrid>
                <MudItem xs="12" md="4">
                    <ObservabilityTimeSeriesChart Title="CPU"
                                                  Series="@HostCpuSeries"
                                                  DataTestId="observability-chart-host-cpu" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <ObservabilityTimeSeriesChart Title="RAM"
                                                  Series="@HostMemorySeries"
                                                  DataTestId="observability-chart-host-memory" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <ObservabilityTimeSeriesChart Title="Disk"
                                                  Series="@HostDiskSeries"
                                                  DataTestId="observability-chart-host-disk" />
                </MudItem>
            </MudGrid>

            <ObservabilityMetricCardRow Title="Runtime (.NET)"
                                        Cards="@RuntimeCards" />

            <ObservabilityMetricCardRow Title="Database"
                                        ColumnWidth="6"
                                        Cards="@DatabaseCards" />

            <MudGrid>
                <MudItem xs="12" md="6">
                    <ObservabilityTimeSeriesChart Title="DB query rate"
                                                  Series="@DbQueryRateSeries"
                                                  DataTestId="observability-chart-db-rate" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <ObservabilityTimeSeriesChart Title="DB P95 latency"
                                                  Series="@DbQueryP95Series"
                                                  DataTestId="observability-chart-db-p95" />
                </MudItem>
            </MudGrid>

            <ObservabilityMetricCardRow Title="HTTP (udgående kald)"
                                        ColumnWidth="6"
                                        Cards="@HttpCards" />

            <MudGrid>
                <MudItem xs="12" md="6">
                    <ObservabilityTimeSeriesChart Title="HTTP client rate"
                                                  Series="@HttpClientRateSeries"
                                                  DataTestId="observability-chart-http-rate" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <ObservabilityTimeSeriesChart Title="HTTP client P95"
                                                  Series="@HttpClientP95Series"
                                                  DataTestId="observability-chart-http-p95" />
                </MudItem>
            </MudGrid>
        }

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-center">
            Last updated: @(Overview?.QueriedAtUtc.ToLocalTime().ToString("g") ?? "—")
            · Lookback: @TimeRangeMinutes min
        </MudText>
    </MudStack>
</MudContainer>

@code {
    [Parameter]
    public string? ServiceName { get; set; }

    [Parameter]
    public int TimeRangeMinutes { get; set; } = 15;

    [Parameter]
    public bool ShowExternalLink { get; set; } = true;

    [Parameter]
    public string ExternalLinkText { get; set; } = "SigNoz";

    [Parameter]
    public bool ShowExtendedPanels { get; set; } = true;

    [Parameter]
    public int AutoRefreshSeconds { get; set; }

    private ObservabilityOverviewSnapshot? Overview;
    private ObservabilityTimeSeriesResult? RequestRateSeries;
    private ObservabilityTimeSeriesResult? P95Series;
    private ObservabilityTimeSeriesResult? HostCpuSeries;
    private ObservabilityTimeSeriesResult? HostMemorySeries;
    private ObservabilityTimeSeriesResult? HostDiskSeries;
    private ObservabilityTimeSeriesResult? DbQueryRateSeries;
    private ObservabilityTimeSeriesResult? DbQueryP95Series;
    private ObservabilityTimeSeriesResult? HttpClientRateSeries;
    private ObservabilityTimeSeriesResult? HttpClientP95Series;
    private IReadOnlyList<ObservabilityMetricCardModel> HostCards = [];
    private IReadOnlyList<ObservabilityMetricCardModel> RuntimeCards = [];
    private IReadOnlyList<ObservabilityMetricCardModel> DatabaseCards = [];
    private IReadOnlyList<ObservabilityMetricCardModel> HttpCards = [];
    private Uri? ExternalUrl;
    private string? ErrorMessage;
    private bool IsLoading;
    private Timer? _refreshTimer;

    private string ResolvedServiceName =>
        string.IsNullOrWhiteSpace(ServiceName)
            ? DashboardService.Options.DefaultServiceName
            : ServiceName;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();

        if (AutoRefreshSeconds > 0)
        {
            _refreshTimer = new Timer(async _ =>
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }, null, TimeSpan.FromSeconds(AutoRefreshSeconds), TimeSpan.FromSeconds(AutoRefreshSeconds));
        }
    }

    private async Task RefreshAsync()
    {
        if (IsLoading)
        {
            return;
        }

        IsLoading = true;
        ErrorMessage = null;

        try
        {
            Overview = await DashboardService.GetOverviewAsync(ResolvedServiceName);
            ExternalUrl = DashboardService.GetExternalDashboardUrl(ResolvedServiceName);

            var timeRange = ObservabilityTimeRange.LastMinutes(TimeRangeMinutes);
            RequestRateSeries = await SafePanelAsync(ObservabilityPanelId.RequestRate, timeRange);
            P95Series = await SafePanelAsync(ObservabilityPanelId.P95Latency, timeRange);

            if (ShowExtendedPanels)
            {
                await LoadExtendedPanelsAsync(timeRange);
            }

            if (HasNoBackendData())
            {
                ErrorMessage = "SigNoz returned no metrics for this period. Check connectivity or generate traffic with the probes below.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadExtendedPanelsAsync(ObservabilityTimeRange timeRange)
    {
        var hostCpu = await SafeScalarAsync(ObservabilityPanelId.HostCpuUtilization, timeRange);
        var hostMemory = await SafeScalarAsync(ObservabilityPanelId.HostMemoryUtilization, timeRange);
        var hostDisk = await SafeScalarAsync(ObservabilityPanelId.HostDiskUtilization, timeRange);
        var gcHeap = await SafeScalarAsync(ObservabilityPanelId.RuntimeGcHeap, timeRange);
        var processMemory = await SafeScalarAsync(ObservabilityPanelId.RuntimeProcessMemory, timeRange);
        var dbRate = await SafeScalarAsync(ObservabilityPanelId.DbQueryRate, timeRange);
        var dbP95 = await SafeScalarAsync(ObservabilityPanelId.DbQueryP95, timeRange);
        var httpRate = await SafeScalarAsync(ObservabilityPanelId.HttpClientRate, timeRange);
        var httpP95 = await SafeScalarAsync(ObservabilityPanelId.HttpClientP95, timeRange);

        HostCards =
        [
            new("CPU", hostCpu, Color.Primary, Icons.Material.Filled.Memory, "observability-metric-host-cpu"),
            new("RAM", hostMemory, Color.Info, Icons.Material.Filled.Storage, "observability-metric-host-memory"),
            new("Disk", hostDisk, Color.Warning, Icons.Material.Filled.SdStorage, "observability-metric-host-disk")
        ];

        RuntimeCards =
        [
            new("GC heap", gcHeap, Color.Secondary, Icons.Material.Filled.Recycling, "observability-metric-runtime-gc"),
            new("Process memory", processMemory, Color.Secondary, Icons.Material.Filled.DataUsage, "observability-metric-runtime-memory")
        ];

        DatabaseCards =
        [
            new("Query rate", dbRate, Color.Tertiary, Icons.Material.Filled.TableChart, "observability-metric-db-rate"),
            new("P95 latency", dbP95, Color.Tertiary, Icons.Material.Filled.QueryStats, "observability-metric-db-p95")
        ];

        HttpCards =
        [
            new("Outbound rate", httpRate, Color.Success, Icons.Material.Filled.CloudUpload, "observability-metric-http-rate"),
            new("P95 latency", httpP95, Color.Success, Icons.Material.Filled.NetworkCheck, "observability-metric-http-p95")
        ];

        HostCpuSeries = await SafePanelAsync(ObservabilityPanelId.HostCpuUtilization, timeRange);
        HostMemorySeries = await SafePanelAsync(ObservabilityPanelId.HostMemoryUtilization, timeRange);
        HostDiskSeries = await SafePanelAsync(ObservabilityPanelId.HostDiskUtilization, timeRange);
        DbQueryRateSeries = await SafePanelAsync(ObservabilityPanelId.DbQueryRate, timeRange);
        DbQueryP95Series = await SafePanelAsync(ObservabilityPanelId.DbQueryP95, timeRange);
        HttpClientRateSeries = await SafePanelAsync(ObservabilityPanelId.HttpClientRate, timeRange);
        HttpClientP95Series = await SafePanelAsync(ObservabilityPanelId.HttpClientP95, timeRange);
    }

    private bool HasNoBackendData() =>
        Overview?.RequestRate is null
        && (RequestRateSeries?.Points.Count ?? 0) == 0
        && HostCards.Count > 0
        && HostCards.All(card => card.Value?.Value == 0);

    private async Task<ObservabilityScalarResult> SafeScalarAsync(
        ObservabilityPanelId panelId,
        ObservabilityTimeRange timeRange)
    {
        try
        {
            return await DashboardService.GetScalarAsync(panelId, ResolvedServiceName, timeRange);
        }
        catch
        {
            var definition = ObservabilityPanelCatalog.GetDefinition(panelId);
            return new ObservabilityScalarResult(0, definition.Unit, definition.Title);
        }
    }

    private async Task<ObservabilityTimeSeriesResult> SafePanelAsync(
        ObservabilityPanelId panelId,
        ObservabilityTimeRange timeRange)
    {
        try
        {
            return await DashboardService.GetPanelAsync(panelId, ResolvedServiceName, timeRange);
        }
        catch
        {
            var definition = ObservabilityPanelCatalog.GetDefinition(panelId);
            return new ObservabilityTimeSeriesResult(definition.Legend, definition.Unit, []);
        }
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}
