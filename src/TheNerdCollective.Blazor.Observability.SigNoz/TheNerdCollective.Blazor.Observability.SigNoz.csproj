<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TheNerdCollective.Blazor.Observability.SigNoz</RootNamespace>
    <AssemblyName>TheNerdCollective.Blazor.Observability.SigNoz</AssemblyName>
    <PackageId>TheNerdCollective.Blazor.Observability.SigNoz</PackageId>
    <Version>1.2.1</Version>
    <Authors>The Nerd Collective</Authors>
    <Description>SigNoz query adapter for TheNerdCollective.Blazor.Observability. Maps preset panels to SigNoz v4 APIs.</Description>
    <PackageTags>blazor;observability;opentelemetry;signoz;adapter</PackageTags>
    <License>Apache-2.0</License>
    <LicenseExpression>Apache-2.0</LicenseExpression>
    <RepositoryUrl>https://github.com/janhjordie/TheNerdCollective.Components</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheNerdCollective.Blazor.Observability\TheNerdCollective.Blazor.Observability.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
