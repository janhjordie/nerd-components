@namespace TheNerdCollective.MudComponents.FeatureFeedback
@using TheNerdCollective.Blazor.FeatureFeedback

<MudPaper Class="pa-3 d-flex gap-3 align-start nerd-feature-idea-card"
          Outlined="true"
          data-testid="nerd-feature-idea-card"
          data-idea-id="@Idea.Id">
    <div class="nerd-feature-idea-card__vote d-flex flex-column align-center">
        <MudIconButton Icon="@(Idea.VotedByCurrentUser ? Icons.Material.Filled.ThumbUp : Icons.Material.Outlined.ThumbUp)"
                       Color="@(Idea.VotedByCurrentUser ? Color.Primary : Color.Default)"
                       title="@VoteLabel"
                       aria-label="@VoteLabel"
                       OnClick="() => OnToggleVote.InvokeAsync(Idea)"
                       data-testid="nerd-feature-idea-vote" />
        <MudText Typo="Typo.subtitle1" data-testid="nerd-feature-idea-votes">@Idea.VoteCount</MudText>
    </div>
    <div class="flex-grow-1">
        <div class="d-flex flex-wrap gap-2 align-center mb-1">
            <MudText Typo="Typo.h6" data-testid="nerd-feature-idea-title">@Idea.Title</MudText>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Idea.Status</MudChip>
        </div>
        <MudText Typo="Typo.body2" data-testid="nerd-feature-idea-description">@Idea.Description</MudText>
        <MudText Typo="Typo.caption" Class="mt-2 mud-text-secondary">
            @Idea.AuthorDisplayName · @Idea.CreatedAtUtc.ToLocalTime().ToString("d")
        </MudText>
    </div>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public FeatureIdeaDto Idea { get; set; } = default!;

    [Parameter]
    public string VoteLabel { get; set; } = "Upvote";

    [Parameter]
    public EventCallback<FeatureIdeaDto> OnToggleVote { get; set; }
}
