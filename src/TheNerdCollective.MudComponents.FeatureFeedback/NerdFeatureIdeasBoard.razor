@namespace TheNerdCollective.MudComponents.FeatureFeedback
@using Microsoft.Extensions.DependencyInjection
@using TheNerdCollective.Blazor.FeatureFeedback
@using TheNerdCollective.Blazor.ReCaptcha
@inject IFeatureFeedbackStore Store
@inject ISnackbar Snackbar
@inject IServiceProvider Services

<section class="nerd-feature-ideas" data-testid="nerd-feature-ideas-board">
    <header class="nerd-feature-ideas__header mb-4">
        <MudText Typo="Typo.h4" data-testid="nerd-feature-ideas-title">@Title</MudText>
        @if (!string.IsNullOrWhiteSpace(Lead))
        {
            <MudText Typo="Typo.body1" Class="mt-1" data-testid="nerd-feature-ideas-lead">@Lead</MudText>
        }
    </header>

    <div class="d-flex flex-wrap gap-3 align-center mb-4">
        <MudTextField @bind-Value="_search"
                      @bind-Value:after="ReloadAsync"
                      Label="@SearchLabel"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      Class="flex-grow-1"
                      data-testid="nerd-feature-ideas-search" />
        <div data-testid="nerd-feature-ideas-sort">
            <MudSelect T="FeatureIdeaSort"
                       @bind-Value="_sort"
                       @bind-Value:after="ReloadAsync"
                       Label="@SortLabel"
                       Variant="Variant.Outlined"
                       Style="min-width: 12rem;">
                <MudSelectItem Value="FeatureIdeaSort.MostVoted">@MostVotedLabel</MudSelectItem>
                <MudSelectItem Value="FeatureIdeaSort.Newest">@NewestLabel</MudSelectItem>
            </MudSelect>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Lightbulb"
                   OnClick="OnSuggestClickedAsync"
                   data-testid="nerd-feature-ideas-suggest">
            @SuggestLabel
        </MudButton>
    </div>

    @if (_isAuthenticated && !string.IsNullOrWhiteSpace(LoginHint))
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4" data-testid="nerd-feature-ideas-login-hint">
            @LoginHint
            @if (!string.IsNullOrWhiteSpace(LoginUrl))
            {
                <MudLink Href="@LoginUrl" Class="ms-1">@LoginLinkLabel</MudLink>
            }
        </MudAlert>
    }

    @if (_isAuthenticated && MaxVotesPerUser is int maxVotes)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4" data-testid="nerd-feature-ideas-vote-budget">
            @FormatVotesBudget(_votesUsed, maxVotes)
        </MudAlert>
    }

    @if (_isAuthenticated && ShowMyVotesFilter)
    {
        <MudChipSet T="string"
                    Class="mb-4"
                    SelectionMode="SelectionMode.SingleSelection"
                    SelectedValue="@_filterMode"
                    SelectedValueChanged="OnFilterModeChanged"
                    data-testid="nerd-feature-ideas-filter">
            <MudChip T="string" Value="@FilterAll">@AllIdeasFilterLabel</MudChip>
            <MudChip T="string" Value="@FilterMyVotes">@MyVotesFilterLabel</MudChip>
        </MudChipSet>
    }

    @if (_showSubmit)
    {
        <MudPaper Class="pa-4 mb-4" Outlined="true" data-testid="nerd-feature-ideas-submit">
            <MudText Typo="Typo.h6" Class="mb-2">@SuggestLabel</MudText>
            <MudForm @ref="_form" @bind-IsValid="_formValid">
                <MudTextField T="string"
                              @bind-Value="_newTitle"
                              @bind-Value:after="OnTitleChanged"
                              Label="@TitleFieldLabel"
                              HelperText="@TitleHelperText"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@InvalidTitleMessage"
                              Immediate="true"
                              Validation="@(new Func<string, string?>(ValidateTitle))"
                              Class="mb-2"
                              data-testid="nerd-feature-ideas-title-input" />
                <MudTextField T="string"
                              @bind-Value="_newDescription"
                              @bind-Value:after="OnDescriptionChanged"
                              Label="@DescriptionFieldLabel"
                              HelperText="@DescriptionHelperText"
                              Variant="Variant.Outlined"
                              Lines="4"
                              Required="true"
                              RequiredError="@InvalidDescriptionMessage"
                              Immediate="true"
                              Validation="@(new Func<string, string?>(ValidateDescription))"
                              Class="mb-3"
                              data-testid="nerd-feature-ideas-description-input" />
            </MudForm>
            @if (_captchaEnabled)
            {
                <div class="mb-3">
                    <NerdReCaptcha Token="_captchaToken"
                                   TokenChanged="OnCaptchaTokenChangedAsync"
                                   SimpleTitle="@CaptchaTitle"
                                   RefreshLabel="@CaptchaRefreshLabel"
                                   HintLabel="@CaptchaHintLabel"
                                   ChallengeLabel="@CaptchaChallengeLabel"
                                   AnswerLabel="@CaptchaAnswerLabel" />
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_submitError))
            {
                <MudAlert Severity="Severity.Warning"
                          Dense="true"
                          Class="mb-3"
                          data-testid="nerd-feature-ideas-submit-error">
                    @_submitError
                </MudAlert>
            }
            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@(!CanSubmit)"
                           OnClick="SubmitIdeaAsync"
                           data-testid="nerd-feature-ideas-submit-button">
                    @SubmitLabel
                </MudButton>
                <MudButton Variant="Variant.Text" OnClick="CancelSubmit">@CancelLabel</MudButton>
            </div>
        </MudPaper>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="mb-4" data-testid="nerd-feature-ideas-loading" />
    }
    else if (!DisplayedIdeas.Any())
    {
        <MudText Typo="Typo.body2" data-testid="nerd-feature-ideas-empty">
            @_showOnlyMyVotes ? MyVotesEmptyLabel : EmptyLabel
        </MudText>
    }
    else
    {
        <MudStack Spacing="2" data-testid="nerd-feature-ideas-list">
            @foreach (var idea in DisplayedIdeas)
            {
                <NerdFeatureIdeaCard Idea="idea"
                                     VoteLabel="@VoteLabel"
                                     WithdrawVoteLabel="@WithdrawVoteLabel"
                                     VotedBadgeLabel="@VotedBadgeLabel"
                                     PlannedLabel="@PlannedLabel"
                                     DisableVoting="@IsVoteDisabled(idea)"
                                     OnToggleVote="ToggleVoteAsync" />
            }
        </MudStack>
    }
</section>

@code {
    private const int MinTitleLength = 3;
    private const int MaxTitleLength = 120;
    private const int MinDescriptionLength = 10;
    private const int MaxDescriptionLength = 2000;

    private const string FilterAll = "all";
    private const string FilterMyVotes = "my-votes";

    private IReadOnlyList<FeatureIdeaDto> _ideas = [];
    private FeatureIdeaSort _sort = FeatureIdeaSort.MostVoted;
    private string _search = "";
    private string _filterMode = FilterAll;
    private int _votesUsed;
    private string _newTitle = "";
    private string _newDescription = "";
    private string? _captchaToken;
    private string? _submitError;
    private bool _loading = true;
    private bool _busy;
    private bool _showSubmit;
    private bool _isAuthenticated;
    private bool _captchaEnabled;
    private bool _formValid;
    private MudForm? _form;
    private INerdReCaptchaVerifier? _captcha;
    private string? _listedForUserId;
    private bool _listLoaded;

    [Parameter] public string Title { get; set; } = "Feature ideas";
    [Parameter] public string? Lead { get; set; } = "We listen to our customers — suggest ideas and upvote what matters.";
    [Parameter] public string? CurrentUserId { get; set; }
    [Parameter] public string? CurrentUserDisplayName { get; set; }
    [Parameter] public string? LoginUrl { get; set; } = "/account/login";
    [Parameter] public string LoginHint { get; set; } = "Sign in to suggest a feature or cast a vote.";
    [Parameter] public string LoginLinkLabel { get; set; } = "Sign in";
    [Parameter] public string SearchLabel { get; set; } = "Search ideas";
    [Parameter] public string SortLabel { get; set; } = "Sort";
    [Parameter] public string MostVotedLabel { get; set; } = "Most voted";
    [Parameter] public string NewestLabel { get; set; } = "Newest";
    [Parameter] public string SuggestLabel { get; set; } = "Suggest a feature";
    [Parameter] public string TitleFieldLabel { get; set; } = "Title";
    [Parameter] public string DescriptionFieldLabel { get; set; } = "Describe the problem or idea";
    [Parameter] public string TitleHelperText { get; set; } = "At least 3 characters.";
    [Parameter] public string DescriptionHelperText { get; set; } = "At least 10 characters.";
    [Parameter] public string SubmitLabel { get; set; } = "Submit idea";
    [Parameter] public string CancelLabel { get; set; } = "Cancel";
    [Parameter] public string EmptyLabel { get; set; } = "No ideas yet — be the first to suggest one.";
    [Parameter] public string VoteLabel { get; set; } = "Upvote";
    [Parameter] public string WithdrawVoteLabel { get; set; } = "Remove vote";
    [Parameter] public string VotedBadgeLabel { get; set; } = "Your vote";
    [Parameter] public string PlannedLabel { get; set; } = "Planned";
    /// <summary>Max ideas a user may vote for (null = unlimited).</summary>
    [Parameter] public int? MaxVotesPerUser { get; set; } = 5;
    [Parameter] public bool AllowWithdrawVote { get; set; } = true;
    [Parameter] public bool ShowMyVotesFilter { get; set; } = true;
    [Parameter] public string AllIdeasFilterLabel { get; set; } = "All ideas";
    [Parameter] public string MyVotesFilterLabel { get; set; } = "My votes";
    [Parameter] public string MyVotesEmptyLabel { get; set; } = "You have not voted on any ideas yet.";
    [Parameter] public string VotesBudgetLabel { get; set; } = "votes used";
    [Parameter] public string VoteLimitReachedMessage { get; set; } = "You have used all your votes.";
    [Parameter] public string WithdrawDisabledMessage { get; set; } = "You cannot withdraw votes.";
    [Parameter] public string CaptchaTitle { get; set; } = "Quick verification";
    [Parameter] public string CaptchaRefreshLabel { get; set; } = "New challenge";
    [Parameter] public string CaptchaHintLabel { get; set; } = "";
    [Parameter] public string CaptchaChallengeLabel { get; set; } = "Solve this to continue";
    [Parameter] public string CaptchaAnswerLabel { get; set; } = "Your answer";
    [Parameter] public string CaptchaFailedMessage { get; set; } = "Please complete the verification challenge.";
    [Parameter] public string InvalidTitleMessage { get; set; } = "Title must be 3–120 characters.";
    [Parameter] public string InvalidDescriptionMessage { get; set; } = "Description must be at least 10 characters.";
    [Parameter] public string SubmitSuccessMessage { get; set; } = "Thanks — your idea was added.";
    [Parameter] public bool RequireCaptchaWhenAvailable { get; set; } = true;
    [Parameter] public EventCallback OnRequireLogin { get; set; }

    private bool _showOnlyMyVotes => _filterMode == FilterMyVotes;

    private IEnumerable<FeatureIdeaDto> DisplayedIdeas =>
        _showOnlyMyVotes ? _ideas.Where(idea => idea.VotedByCurrentUser) : _ideas;

    private bool CanAddVote =>
        MaxVotesPerUser is null || _votesUsed < MaxVotesPerUser.Value;

    private bool IsVoteDisabled(FeatureIdeaDto idea) =>
        !idea.VotedByCurrentUser && !CanAddVote;

    private string FormatVotesBudget(int used, int max) => $"{used} / {max} {VotesBudgetLabel}";

    private Task OnFilterModeChanged(string? mode)
    {
        _filterMode = string.IsNullOrWhiteSpace(mode) ? FilterAll : mode;
        return Task.CompletedTask;
    }

    private bool CanSubmit =>
        !_busy
        && _formValid
        && (!_captchaEnabled || !string.IsNullOrWhiteSpace(_captchaToken));

    protected override void OnInitialized()
    {
        _captcha = Services.GetService<INerdReCaptchaVerifier>();
        _captchaEnabled = RequireCaptchaWhenAvailable && _captcha is not null;
    }

    protected override async Task OnParametersSetAsync()
    {
        _isAuthenticated = !string.IsNullOrWhiteSpace(CurrentUserId);
        // Avoid reloading on every parent render — that races captcha TokenChanged.
        if (!_listLoaded || !string.Equals(_listedForUserId, CurrentUserId, StringComparison.Ordinal))
        {
            _listedForUserId = CurrentUserId;
            _listLoaded = true;
            await ReloadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            _ideas = await Store.ListAsync(_sort, string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(), CurrentUserId);
            await RefreshVoteBudgetAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshVoteBudgetAsync()
    {
        if (!_isAuthenticated || string.IsNullOrWhiteSpace(CurrentUserId) || MaxVotesPerUser is null)
        {
            _votesUsed = 0;
            return;
        }

        var allIdeas = await Store.ListAsync(_sort, search: null, currentUserId: CurrentUserId);
        _votesUsed = allIdeas.Count(idea => idea.VotedByCurrentUser);
    }

    private async Task OnSuggestClickedAsync()
    {
        if (!_isAuthenticated)
        {
            if (OnRequireLogin.HasDelegate)
            {
                await OnRequireLogin.InvokeAsync();
            }
            else if (!string.IsNullOrWhiteSpace(LoginUrl))
            {
                Snackbar.Add(LoginHint, Severity.Info);
            }

            return;
        }

        _showSubmit = true;
        _captchaToken = null;
        _submitError = null;
        _formValid = false;
        _newTitle = "";
        _newDescription = "";
    }

    private void CancelSubmit()
    {
        _showSubmit = false;
        _submitError = null;
        _formValid = false;
    }

    private void OnTitleChanged() => _submitError = null;

    private void OnDescriptionChanged() => _submitError = null;

    private Task OnCaptchaTokenChangedAsync(string? token)
    {
        _captchaToken = token;
        _submitError = null;
        return Task.CompletedTask;
    }

    private string? ValidateTitle(string value)
    {
        var length = value?.Trim().Length ?? 0;
        return length is >= MinTitleLength and <= MaxTitleLength
            ? null
            : InvalidTitleMessage;
    }

    private string? ValidateDescription(string value)
    {
        var length = value?.Trim().Length ?? 0;
        return length is >= MinDescriptionLength and <= MaxDescriptionLength
            ? null
            : InvalidDescriptionMessage;
    }

    private async Task SubmitIdeaAsync()
    {
        if (!_isAuthenticated || string.IsNullOrWhiteSpace(CurrentUserId))
        {
            await OnSuggestClickedAsync();
            return;
        }

        if (_form is not null)
        {
            await _form.ValidateAsync();
        }

        if (!CanSubmit)
        {
            _submitError = ResolveValidationMessage();
            return;
        }

        _busy = true;
        _submitError = null;
        try
        {
            if (_captchaEnabled && _captcha is not null)
            {
                var captcha = await _captcha.VerifyAsync(_captchaToken);
                if (!captcha.Success)
                {
                    ShowError(CaptchaFailedMessage);
                    return;
                }
            }

            var result = await Store.CreateAsync(
                new CreateFeatureIdeaRequest(
                    _newTitle,
                    _newDescription,
                    CurrentUserDisplayName ?? "Customer"),
                CurrentUserId);

            if (!result.Success)
            {
                ShowError(MapError(result.ErrorCode));
                return;
            }

            _newTitle = "";
            _newDescription = "";
            _captchaToken = null;
            _showSubmit = false;
            Snackbar.Add(SubmitSuccessMessage, Severity.Success);
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleVoteAsync(FeatureIdeaDto idea)
    {
        if (!_isAuthenticated || string.IsNullOrWhiteSpace(CurrentUserId))
        {
            await OnSuggestClickedAsync();
            return;
        }

        if (!AllowWithdrawVote && idea.VotedByCurrentUser)
        {
            ShowError(WithdrawDisabledMessage);
            return;
        }

        var result = await Store.ToggleVoteAsync(
            idea.Id,
            CurrentUserId,
            MaxVotesPerUser,
            AllowWithdrawVote);
        if (!result.Success)
        {
            ShowError(MapError(result.ErrorCode));
            return;
        }

        await ReloadAsync();
    }

    private void ShowError(string message)
    {
        _submitError = message;
        Snackbar.Add(message, Severity.Warning);
    }

    private string ResolveValidationMessage()
    {
        if (_newTitle.Trim().Length is < MinTitleLength or > MaxTitleLength)
        {
            return InvalidTitleMessage;
        }

        if (_newDescription.Trim().Length is < MinDescriptionLength or > MaxDescriptionLength)
        {
            return InvalidDescriptionMessage;
        }

        if (_captchaEnabled && string.IsNullOrWhiteSpace(_captchaToken))
        {
            return CaptchaFailedMessage;
        }

        return InvalidDescriptionMessage;
    }

    private string MapError(string? errorCode) => errorCode switch
    {
        "invalid-title" => InvalidTitleMessage,
        "invalid-description" => InvalidDescriptionMessage,
        "unauthenticated" => LoginHint,
        "vote-limit-reached" => VoteLimitReachedMessage,
        "withdraw-disabled" => WithdrawDisabledMessage,
        "missing-input-response" or "challenge-not-found" or "challenge-expired" or "incorrect-answer"
            or "invalid-simple-token" => CaptchaFailedMessage,
        _ => errorCode ?? "Could not save idea"
    };
}
