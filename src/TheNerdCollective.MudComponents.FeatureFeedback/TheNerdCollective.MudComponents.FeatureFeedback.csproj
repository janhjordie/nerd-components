<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TheNerdCollective.MudComponents.FeatureFeedback</RootNamespace>
    <AssemblyName>TheNerdCollective.MudComponents.FeatureFeedback</AssemblyName>
    <PackageId>TheNerdCollective.MudComponents.FeatureFeedback</PackageId>
    <Version>1.0.0</Version>
    <Authors>The Nerd Collective</Authors>
    <Description>MudBlazor feature ideas board with suggest + upvote UI (PollUnit-style). Requires TheNerdCollective.Blazor.FeatureFeedback.</Description>
    <PackageTags>mudblazor;blazor;feature-feedback;upvote;ideas;roadmap;components</PackageTags>
    <License>Apache-2.0</License>
    <LicenseExpression>Apache-2.0</LicenseExpression>
    <RepositoryUrl>https://github.com/janhjordie/TheNerdCollective.Components</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheNerdCollective.Blazor.FeatureFeedback\TheNerdCollective.Blazor.FeatureFeedback.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
