@namespace TheNerdCollective.MudComponents.FeatureFeedback
@using TheNerdCollective.Blazor.FeatureFeedback
@inject IFeatureFeedbackStore Store
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<section class="nerd-feature-ideas-admin" data-testid="nerd-feature-ideas-admin">
    <MudText Typo="Typo.h4" Class="mb-2" data-testid="nerd-feature-ideas-admin-title">@Title</MudText>
    @if (!string.IsNullOrWhiteSpace(Lead))
    {
        <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">@Lead</MudText>
    }

    <MudTextField @bind-Value="_search"
                  @bind-Value:after="ReloadAsync"
                  Label="@SearchLabel"
                  Variant="Variant.Outlined"
                  Class="mb-4"
                  Immediate="true"
                  data-testid="nerd-feature-ideas-admin-search" />

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_ideas.Count == 0)
    {
        <MudText Typo="Typo.body2">@EmptyLabel</MudText>
    }
    else
    {
        <MudTable Items="_ideas" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" data-testid="nerd-feature-ideas-admin-table">
            <HeaderContent>
                <MudTh>Votes</MudTh>
                <MudTh>Idea</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Planned release</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Votes">@context.VoteCount</MudTd>
                <MudTd DataLabel="Idea">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                        <MudText Typo="Typo.subtitle2">@context.Title</MudText>
                        @if (context.Status == FeatureIdeaStatus.Deleted)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                Deleted
                            </MudChip>
                        }
                    </MudStack>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.AuthorDisplayName · @context.CreatedAtUtc.ToLocalTime().ToString("g")</MudText>
                    <MudText Typo="Typo.body2" Class="mt-1">@context.Description</MudText>
                </MudTd>
                <MudTd DataLabel="Status">
                    @if (context.Status == FeatureIdeaStatus.Deleted)
                    {
                        <MudText Typo="Typo.body2">Deleted</MudText>
                    }
                    else
                    {
                        <MudSelect T="FeatureIdeaStatus"
                                   Value="@context.Status"
                                   ValueChanged="status => OnStatusChangedAsync(context, status)"
                                   Dense="true"
                                   Variant="Variant.Outlined"
                                   data-testid="nerd-feature-ideas-admin-status">
                            @foreach (var status in ActiveStatuses)
                            {
                                <MudSelectItem Value="@status">@status</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </MudTd>
                <MudTd DataLabel="Planned release">
                    <MudDatePicker Date="@ToDateTime(context.PlannedReleaseDate)"
                                   DateChanged="date => OnPlannedDateChangedAsync(context, date)"
                                   Label="Release"
                                   Variant="Variant.Outlined"
                                   Editable="true"
                                   Disabled="@(context.Status == FeatureIdeaStatus.Deleted)"
                                   data-testid="nerd-feature-ideas-admin-planned" />
                </MudTd>
                <MudTd>
                    <MudStack Row="true" Spacing="1" Class="flex-wrap">
                        @if (context.Status == FeatureIdeaStatus.Deleted)
                        {
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       OnClick="() => RestoreAsync(context)"
                                       data-testid="nerd-feature-ideas-admin-restore">
                                Restore
                            </MudButton>
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       OnClick="() => HardDeleteAsync(context)"
                                       data-testid="nerd-feature-ideas-admin-hard-delete">
                                Hard delete
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Text"
                                       Color="Color.Primary"
                                       OnClick="() => MarkDoneAsync(context)"
                                       data-testid="nerd-feature-ideas-admin-done">
                                Mark done
                            </MudButton>
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       OnClick="() => SoftDeleteAsync(context)"
                                       data-testid="nerd-feature-ideas-admin-soft-delete">
                                Soft delete
                            </MudButton>
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       OnClick="() => HardDeleteAsync(context)"
                                       data-testid="nerd-feature-ideas-admin-hard-delete">
                                Hard delete
                            </MudButton>
                        }
                    </MudStack>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</section>

@code {
    private static readonly FeatureIdeaStatus[] ActiveStatuses =
    [
        FeatureIdeaStatus.Open,
        FeatureIdeaStatus.Planned,
        FeatureIdeaStatus.InProgress,
        FeatureIdeaStatus.Done,
        FeatureIdeaStatus.Declined
    ];

    private IReadOnlyList<FeatureIdeaDto> _ideas = [];
    private string _search = "";
    private bool _loading = true;

    [Parameter] public string Title { get; set; } = "Feature ideas admin";
    [Parameter] public string? Lead { get; set; } = "Update status and planned release dates.";
    [Parameter] public string SearchLabel { get; set; } = "Search";
    [Parameter] public string EmptyLabel { get; set; } = "No ideas yet.";
    [Parameter] public string SoftDeleteConfirmTitle { get; set; } = "Soft delete idea?";
    [Parameter] public string SoftDeleteConfirmMessage { get; set; } = "The idea will be hidden from the public board but can be restored.";
    [Parameter] public string HardDeleteConfirmTitle { get; set; } = "Permanently delete idea?";
    [Parameter] public string HardDeleteConfirmMessage { get; set; } = "This permanently removes the idea and its votes. This cannot be undone.";

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            _ideas = await Store.ListAsync(
                FeatureIdeaSort.MostVoted,
                string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(),
                includeDeleted: true);
        }
        finally
        {
            _loading = false;
        }
    }

    private static DateTime? ToDateTime(DateOnly? date) =>
        date?.ToDateTime(TimeOnly.MinValue, DateTimeKind.Unspecified);

    private async Task OnStatusChangedAsync(FeatureIdeaDto idea, FeatureIdeaStatus status)
    {
        if (status == FeatureIdeaStatus.Deleted)
        {
            await SoftDeleteAsync(idea);
            return;
        }

        var result = await Store.UpdateAsync(idea.Id, new UpdateFeatureIdeaRequest(status, idea.PlannedReleaseDate));
        if (!result.Success)
        {
            Snackbar.Add(result.ErrorCode ?? "Update failed", Severity.Error);
            return;
        }

        await ReloadAsync();
    }

    private async Task OnPlannedDateChangedAsync(FeatureIdeaDto idea, DateTime? date)
    {
        if (idea.Status == FeatureIdeaStatus.Deleted)
        {
            return;
        }

        DateOnly? planned = date is null ? null : DateOnly.FromDateTime(DateTime.SpecifyKind(date.Value, DateTimeKind.Unspecified));
        var status = idea.Status;
        if (planned is not null && status == FeatureIdeaStatus.Open)
        {
            status = FeatureIdeaStatus.Planned;
        }

        var result = await Store.UpdateAsync(idea.Id, new UpdateFeatureIdeaRequest(status, planned));
        if (!result.Success)
        {
            Snackbar.Add(result.ErrorCode ?? "Update failed", Severity.Error);
            return;
        }

        await ReloadAsync();
    }

    private async Task MarkDoneAsync(FeatureIdeaDto idea)
    {
        var result = await Store.UpdateAsync(
            idea.Id,
            new UpdateFeatureIdeaRequest(FeatureIdeaStatus.Done, idea.PlannedReleaseDate));
        if (!result.Success)
        {
            Snackbar.Add(result.ErrorCode ?? "Update failed", Severity.Error);
            return;
        }

        Snackbar.Add("Marked as done.", Severity.Success);
        await ReloadAsync();
    }

    private async Task SoftDeleteAsync(FeatureIdeaDto idea)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            SoftDeleteConfirmTitle,
            $"{SoftDeleteConfirmMessage}\n\n“{idea.Title}”",
            yesText: "Soft delete",
            cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        var result = await Store.SoftDeleteAsync(idea.Id);
        if (!result.Success)
        {
            Snackbar.Add(result.ErrorCode ?? "Soft delete failed", Severity.Error);
            return;
        }

        Snackbar.Add("Idea soft-deleted.", Severity.Success);
        await ReloadAsync();
    }

    private async Task HardDeleteAsync(FeatureIdeaDto idea)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            HardDeleteConfirmTitle,
            $"{HardDeleteConfirmMessage}\n\n“{idea.Title}”",
            yesText: "Hard delete",
            cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        var result = await Store.HardDeleteAsync(idea.Id);
        if (!result.Success)
        {
            Snackbar.Add(result.ErrorCode ?? "Hard delete failed", Severity.Error);
            return;
        }

        Snackbar.Add("Idea permanently deleted.", Severity.Success);
        await ReloadAsync();
    }

    private async Task RestoreAsync(FeatureIdeaDto idea)
    {
        var result = await Store.RestoreAsync(idea.Id);
        if (!result.Success)
        {
            Snackbar.Add(result.ErrorCode ?? "Restore failed", Severity.Error);
            return;
        }

        Snackbar.Add("Idea restored.", Severity.Success);
        await ReloadAsync();
    }
}
