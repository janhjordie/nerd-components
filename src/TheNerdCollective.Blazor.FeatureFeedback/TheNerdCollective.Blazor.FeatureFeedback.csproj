<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TheNerdCollective.Blazor.FeatureFeedback</RootNamespace>
    <AssemblyName>TheNerdCollective.Blazor.FeatureFeedback</AssemblyName>
    <PackageId>TheNerdCollective.Blazor.FeatureFeedback</PackageId>
    <Version>1.2.0</Version>
    <Authors>The Nerd Collective</Authors>
    <Description>Host-agnostic feature idea / upvote abstractions for Blazor apps (PollUnit-style collect ideas boards).</Description>
    <PackageTags>blazor;feature-feedback;upvote;ideas;roadmap;components</PackageTags>
    <License>Apache-2.0</License>
    <LicenseExpression>Apache-2.0</LicenseExpression>
    <RepositoryUrl>https://github.com/janhjordie/TheNerdCollective.Components</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
