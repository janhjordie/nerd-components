@using TheNerdCollective.Blazor.SessionMonitor
@using MudBlazor
@inject ISessionMonitorService SessionMonitor

<MudPaper Class="@($"pa-2 {Class}")" Elevation="@Elevation">
    <MudStack Row="true" Spacing="4" Class="align-center">
        @if (ShowActive)
        {
            <MudStack Row="true" Spacing="1" Class="align-center">
                <MudIcon Icon="@Icons.Material.Filled.Cloud" Color="Color.Primary" Size="Size.Small"/>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Active:</MudText>
                <MudText Typo="Typo.body1"><b>@DisplayMetrics.ActiveSessions</b></MudText>
            </MudStack>
        }

        @if (ShowDisconnected)
        {
            <MudDivider Vertical="true" FlexItem="true"/>
            <MudStack Row="true" Spacing="1" Class="align-center">
                <MudIcon Icon="@Icons.Material.Filled.SignalWifiStatusbarConnectedNoInternet4"
                         Color="@(DisplayMetrics.DisconnectedSessions > 0 ? Color.Warning : Color.Success)" Size="Size.Small"/>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Held:</MudText>
                <MudText Typo="Typo.body1"><b>@DisplayMetrics.DisconnectedSessions</b></MudText>
            </MudStack>
        }

        @if (ShowPeak)
        {
            <MudDivider Vertical="true" FlexItem="true"/>
            <MudStack Row="true" Spacing="1" Class="align-center">
                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Warning" Size="Size.Small"/>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Peak:</MudText>
                <MudText Typo="Typo.body1"><b>@DisplayMetrics.PeakSessions</b></MudText>
            </MudStack>
        }

        @if (ShowDisconnects)
        {
            <MudDivider Vertical="true" FlexItem="true"/>
            <MudStack Row="true" Spacing="1" Class="align-center">
                <MudIcon Icon="@Icons.Material.Filled.LinkOff" Color="Color.Error" Size="Size.Small"/>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Disconnects:</MudText>
                <MudText Typo="Typo.body1"><b>@FormatLargeNumber(DisplayMetrics.TotalDisconnects)</b></MudText>
            </MudStack>
        }

        @if (ShowReconnects)
        {
            <MudDivider Vertical="true" FlexItem="true"/>
            <MudStack Row="true" Spacing="1" Class="align-center">
                <MudIcon Icon="@Icons.Material.Filled.Link" Color="Color.Success" Size="Size.Small"/>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Reconnects:</MudText>
                <MudText Typo="Typo.body1"><b>@FormatLargeNumber(DisplayMetrics.TotalReconnects)</b></MudText>
            </MudStack>
        }

        @if (ShowReconnectRate)
        {
            <MudDivider Vertical="true" FlexItem="true"/>
            <MudStack Row="true" Spacing="1" Class="align-center">
                <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Info" Size="Size.Small"/>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Rate:</MudText>
                <MudText Typo="Typo.body1"><b>@ReconnectRate</b></MudText>
            </MudStack>
        }

        @if (ShowCircuitsOpened)
        {
            <MudDivider Vertical="true" FlexItem="true"/>
            <MudStack Row="true" Spacing="1" Class="align-center">
                <MudIcon Icon="@Icons.Material.Filled.Lan" Color="Color.Info" Size="Size.Small"/>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Circuits opened:</MudText>
                <MudText Typo="Typo.body1"><b>@FormatLargeNumber(DisplayMetrics.TotalCircuitsOpened)</b></MudText>
            </MudStack>
        }

        @if (ShowStarted)
        {
            <MudDivider Vertical="true" FlexItem="true"/>
            <MudStack Row="true" Spacing="1" Class="align-center">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small"/>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Client sessions:</MudText>
                <MudText Typo="Typo.body1"><b>@FormatLargeNumber(DisplayMetrics.TotalSessionsStarted)</b></MudText>
            </MudStack>
        }

        @if (ShowEnded)
        {
            <MudDivider Vertical="true" FlexItem="true"/>
            <MudStack Row="true" Spacing="1" Class="align-center">
                <MudIcon Icon="@Icons.Material.Filled.CancelScheduleSend" Color="Color.Info" Size="Size.Small"/>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Ended:</MudText>
                <MudText Typo="Typo.body1"><b>@FormatLargeNumber(DisplayMetrics.TotalSessionsEnded)</b></MudText>
            </MudStack>
        }

        @if (ShowAvgDuration && DisplayMetrics.AverageSessionDurationSeconds.HasValue)
        {
            <MudDivider Vertical="true" FlexItem="true"/>
            <MudStack Row="true" Spacing="1" Class="align-center">
                <MudIcon Icon="@Icons.Material.Filled.Timer" Color="Color.Default" Size="Size.Small"/>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Avg:</MudText>
                <MudText Typo="Typo.body1"><b>@FormatDuration(DisplayMetrics.AverageSessionDurationSeconds.Value)</b></MudText>
            </MudStack>
        }

        @if (ShowRefreshButton)
        {
            <MudSpacer/>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" 
                          Size="Size.Small"
                          OnClick="Refresh"/>
        }
    </MudStack>
</MudPaper>

@code {
    private SessionMetrics CurrentMetrics = new();
    private DateTime? _lastRefreshToken;

    /// <summary>
    /// Optional parent-provided metrics. When set, the bar displays these values instead of self-fetching.
    /// </summary>
    [Parameter]
    public SessionMetrics? Metrics { get; set; }

    /// <summary>
    /// When <see cref="Metrics"/> is not provided, changing this token triggers a refresh from the service.
    /// </summary>
    [Parameter]
    public DateTime? RefreshToken { get; set; }

    private SessionMetrics DisplayMetrics => Metrics ?? CurrentMetrics;

    private string ReconnectRate =>
        DisplayMetrics.TotalDisconnects > 0
            ? $"{(double)DisplayMetrics.TotalReconnects / DisplayMetrics.TotalDisconnects * 100:F0}%"
            : "—";

    /// <summary>
    /// Whether to show active sessions count.
    /// </summary>
    [Parameter]
    public bool ShowActive { get; set; } = true;

    /// <summary>
    /// Whether to show disconnected (retained) circuit count.
    /// </summary>
    [Parameter]
    public bool ShowDisconnected { get; set; }

    /// <summary>
    /// Whether to show peak sessions count.
    /// </summary>
    [Parameter]
    public bool ShowPeak { get; set; } = true;

    /// <summary>
    /// Whether to show total disconnect events.
    /// </summary>
    [Parameter]
    public bool ShowDisconnects { get; set; }

    /// <summary>
    /// Whether to show total reconnect events.
    /// </summary>
    [Parameter]
    public bool ShowReconnects { get; set; }

    /// <summary>
    /// Whether to show reconnect / disconnect rate.
    /// </summary>
    [Parameter]
    public bool ShowReconnectRate { get; set; }

    /// <summary>
    /// Whether to show total circuits opened (includes reloads).
    /// </summary>
    [Parameter]
    public bool ShowCircuitsOpened { get; set; } = true;

    /// <summary>
    /// Whether to show deduplicated unique client sessions started.
    /// </summary>
    [Parameter]
    public bool ShowStarted { get; set; } = true;

    /// <summary>
    /// Whether to show total sessions ended.
    /// </summary>
    [Parameter]
    public bool ShowEnded { get; set; } = true;

    /// <summary>
    /// Whether to show average session duration.
    /// </summary>
    [Parameter]
    public bool ShowAvgDuration { get; set; } = true;

    /// <summary>
    /// Whether to show the refresh button.
    /// </summary>
    [Parameter]
    public bool ShowRefreshButton { get; set; } = true;

    /// <summary>
    /// Elevation of the paper container.
    /// </summary>
    [Parameter]
    public int Elevation { get; set; } = 1;

    /// <summary>
    /// Additional CSS classes.
    /// </summary>
    [Parameter]
    public string Class { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        if (Metrics is null)
            Refresh();
    }

    protected override void OnParametersSet()
    {
        if (Metrics is not null)
            return;

        if (RefreshToken.HasValue && RefreshToken != _lastRefreshToken)
        {
            _lastRefreshToken = RefreshToken;
            Refresh();
        }
    }

    /// <summary>
    /// Manually refresh all metrics.
    /// </summary>
    public void Refresh()
    {
        CurrentMetrics = SessionMonitor.GetCurrentMetrics();
        StateHasChanged();
    }

    private string FormatLargeNumber(long number)
    {
        if (number >= 1000000)
            return $"{number / 1000000.0:F1}M";
        if (number >= 1000)
            return $"{number / 1000.0:F1}K";
        return number.ToString();
    }

    private string FormatDuration(double seconds)
    {
        var ts = TimeSpan.FromSeconds(seconds);
        if (ts.TotalHours >= 1)
            return $"{ts.Hours}h {ts.Minutes}m";
        if (ts.TotalMinutes >= 1)
            return $"{ts.Minutes}m {ts.Seconds}s";
        return $"{ts.Seconds}s";
    }
}
