@using TheNerdCollective.Blazor.SessionMonitor
@using MudBlazor
@implements IDisposable
@inject ISessionMonitorService SessionMonitor

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-2">
    <MudStack Spacing="1">
        <MudStack Row="true" Spacing="1" Class="align-center flex-wrap">
            <MudIcon Icon="@Icons.Material.Filled.Monitor" Size="Size.Small" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Live Session Monitor</MudText>
            <MudSpacer />
            <MudStack Row="true" Spacing="1" Class="align-center flex-wrap">
                @if (!string.IsNullOrWhiteSpace(_metrics.InstanceId))
                {
                    <MudTooltip Text="Per-replica metrics. Sticky sessions keep this view on one instance.">
                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined"
                                 Icon="@Icons.Material.Filled.Dns">
                            @_metrics.InstanceId
                        </MudChip>
                    </MudTooltip>
                }
                @if (_metrics.IsDegradedMode)
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled"
                             Icon="@Icons.Material.Filled.Speed">
                        Summary (≥@_metrics.DegradedModeThreshold)
                    </MudChip>
                }
                <DeploymentSafetyIndicator RefreshToken="@_metrics.Timestamp" ChipSize="Size.Small" />
                <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined"
                         Icon="@Icons.Material.Filled.Update">
                    @(_autoRefresh ? $"Live ({RefreshIntervalSeconds}s)" : "Paused")
                </MudChip>
                <MudIconButton Icon="@(_autoRefresh ? Icons.Material.Filled.Pause : Icons.Material.Filled.PlayArrow)"
                               Size="Size.Small" Color="Color.Primary"
                               OnClick="ToggleAutoRefresh" />
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                               OnClick="Refresh" />
            </MudStack>
        </MudStack>

        <QuickMetricsBar Metrics="@_metrics"
                         ShowRefreshButton="false"
                         ShowCircuitsOpened="false"
                         ShowStarted="false"
                         ShowEnded="false"
                         ShowAvgDuration="false"
                         ShowDisconnected="true"
                         ShowDisconnects="true"
                         ShowReconnects="true"
                         ShowReconnectRate="true"
                         Elevation="0" />

        @if (_metrics.IsDegradedMode)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Icon="@Icons.Material.Filled.Speed">
                Circuit details hidden. History capped at @_metrics.EffectiveHistoryCap snapshots.
            </MudAlert>
        }

        <MudTabs Outlined="true" ApplyEffectsToContainer="true">
            <MudTabPanel Text="By Browser" Icon="@Icons.Material.Filled.Devices">
                <ClientSessionCountsTable RefreshToken="@_metrics.Timestamp"
                                         IsDegradedMode="@_metrics.IsDegradedMode"
                                         BrowserChips="BrowserChips" />
            </MudTabPanel>
            <MudTabPanel Text="By URL" Icon="@Icons.Material.Filled.Link">
                <UrlSessionCountsTable RefreshToken="@_metrics.Timestamp" IsDegradedMode="@_metrics.IsDegradedMode" />
            </MudTabPanel>
            <MudTabPanel Text="Active Circuits" Icon="@Icons.Material.Filled.Lan" Disabled="@_metrics.IsDegradedMode">
                <SessionDetailsTable RefreshToken="@_metrics.Timestamp" IsDegradedMode="@_metrics.IsDegradedMode" />
            </MudTabPanel>
            <MudTabPanel Text="History" Icon="@Icons.Material.Filled.History">
                <SessionHistoryChart IsDegradedMode="@_metrics.IsDegradedMode" EffectiveHistoryCap="@_metrics.EffectiveHistoryCap" />
            </MudTabPanel>
            <MudTabPanel Text="Deploy windows" Icon="@Icons.Material.Filled.Timeline">
                <DeploymentWindowsTable IsDegradedMode="@_metrics.IsDegradedMode" />
            </MudTabPanel>
        </MudTabs>

        <MudText Typo="Typo.caption" Color="Color.Secondary">
            Updated @_metrics.Timestamp.ToLocalTime().ToString("G")
            @if (_metrics.AverageSessionDurationSeconds.HasValue)
            {
                <text> · avg @FormatDuration(_metrics.AverageSessionDurationSeconds.Value)</text>
            }
            · opened @_metrics.TotalCircuitsOpened · clients @_metrics.TotalSessionsStarted · ended @_metrics.TotalSessionsEnded
            · since @_metrics.TrackingSince.ToLocalTime().ToString("g")
        </MudText>
    </MudStack>
</MudContainer>

@code {
    private SessionMetrics _metrics = new();
    private Timer? _refreshTimer;
    private bool _autoRefresh = true;

    [Parameter] public int RefreshIntervalSeconds { get; set; } = 5;

    /// <summary>
    /// Optional chips beside each browser label. Host-specific markers stay outside this package.
    /// </summary>
    [Parameter] public RenderFragment<ActiveClientSessionSummary>? BrowserChips { get; set; }

    protected override void OnInitialized()
    {
        Refresh();
        StartAutoRefresh();
    }

    private void Refresh()
    {
        _metrics = SessionMonitor.GetCurrentMetrics();
    }

    private void ToggleAutoRefresh()
    {
        _autoRefresh = !_autoRefresh;
        if (_autoRefresh)
            StartAutoRefresh();
        else
            StopAutoRefresh();
    }

    private void StartAutoRefresh()
    {
        StopAutoRefresh();
        _refreshTimer = new Timer(_ =>
        {
            Refresh();
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(RefreshIntervalSeconds), TimeSpan.FromSeconds(RefreshIntervalSeconds));
    }

    private void StopAutoRefresh()
    {
        _refreshTimer?.Dispose();
        _refreshTimer = null;
    }

    private static string FormatDuration(double seconds)
    {
        var ts = TimeSpan.FromSeconds(seconds);
        if (ts.TotalMinutes < 1) return $"{ts.Seconds}s";
        if (ts.TotalHours < 1) return $"{ts.Minutes}m {ts.Seconds}s";
        return $"{ts.Hours}h {ts.Minutes}m";
    }

    public void Dispose() => StopAutoRefresh();
}
