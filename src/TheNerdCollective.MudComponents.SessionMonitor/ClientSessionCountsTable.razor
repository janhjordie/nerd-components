@using TheNerdCollective.Blazor.SessionMonitor
@using MudBlazor
@inject ISessionMonitorService SessionMonitor

<MudStack Spacing="3" Class="pa-4">
    <MudStack Row="true" Class="align-center flex-wrap" Spacing="2">
        <MudText Typo="Typo.subtitle1">
            Active sessions by browser: @_totalActiveSessions circuits across @_clientSummaries.Count browsers
        </MudText>
        <MudSpacer />
        @if (_clientSummaries.Count > 0)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                @_clientSummaries.Count unique browsers
            </MudChip>
        }
    </MudStack>

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        Circuits from the same browser share the session monitor cookie (<code>.bs-sm-client</code>). Tabs from one browser are grouped together below.
    </MudAlert>

    @if (IsDegradedMode)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-2">
            Showing top browser clients only in summary-only mode.
        </MudAlert>
    }

    @if (_clientSummaries.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            No active sessions at this moment.
        </MudAlert>
    }
    else
    {
        <MudSimpleTable Dense="true" Hover="true" Bordered="true" Class="mb-2">
            <thead>
                <tr>
                    <th>Browser</th>
                    <th>Circuits</th>
                    <th>URLs</th>
                    <th>Connected</th>
                    <th>Disconnected</th>
                    <th>Share</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var summary in _clientSummaries)
                {
                    <tr>
                        <td>
                            <MudStack Spacing="1">
                                <MudStack Row="true" Spacing="1" Class="align-center flex-wrap">
                                    <MudText Typo="Typo.body2"><b>@summary.ClientLabel</b></MudText>
                                    @if (summary.IsAdminMonitorGroup)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined"
                                                 Icon="@Icons.Material.Filled.AdminPanelSettings">
                                            Admin
                                        </MudChip>
                                    }
                                </MudStack>
                                <ClientEnvironmentChips Environment="@summary.ClientEnvironment" />
                            </MudStack>
                        </td>
                        <td><MudText Typo="Typo.body2"><b>@summary.ActiveSessionCount</b></MudText></td>
                        <td><MudText Typo="Typo.body2">@summary.DistinctPathCount</MudText></td>
                        <td><MudText Typo="Typo.body2" Color="Color.Success">@summary.ConnectedCount</MudText></td>
                        <td>
                            @if (summary.DisconnectedCount > 0)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Warning">@summary.DisconnectedCount</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">0</MudText>
                            }
                        </td>
                        <td>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@($"{GetSharePercent(summary.ActiveSessionCount):F0}%")</MudText>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>

        <MudExpansionPanels MultiExpansion="true">
            @foreach (var group in _clientSummaries)
            {
                <MudExpansionPanel Text="@GetPanelTitle(group)" Expanded="@(group.ActiveSessionCount <= 3)">
                    <MudStack Spacing="2" Class="mb-2">
                        <ClientEnvironmentChips Environment="@group.ClientEnvironment" />
                        @if (!string.IsNullOrWhiteSpace(group.ClientEnvironment.UserAgent))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@group.ClientEnvironment.UserAgent</MudText>
                        }
                    </MudStack>
                    <MudStack Spacing="1">
                        @foreach (var circuit in group.Circuits)
                        {
                            <MudPaper Class="pa-2" Elevation="0" Outlined="true">
                                <MudStack Row="true" Spacing="2" Class="align-center flex-wrap">
                                    <MudIcon Icon="@Icons.Material.Filled.Lan" Size="Size.Small" Color="@(circuit.IsDisconnected ? Color.Warning : Color.Success)" />
                                    <MudText Typo="Typo.body2">@(circuit.CurrentPath ?? "—")</MudText>
                                    @if (circuit.IsOnAdminMonitorPath)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">Monitor</MudChip>
                                    }
                                    <MudSpacer />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@circuit.CircuitId</MudText>
                                    @if (circuit.IsDisconnected)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Disconnected</MudChip>
                                    }
                                </MudStack>
                            </MudPaper>
                        }
                    </MudStack>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    }

    <MudButton Variant="Variant.Outlined"
               Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="RefreshSummaries">
        Refresh List
    </MudButton>
</MudStack>

@code {
    private List<ActiveClientSessionSummary> _clientSummaries = [];
    private int _totalActiveSessions;

    [Parameter] public DateTime RefreshToken { get; set; }

    [Parameter] public bool IsDegradedMode { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await RefreshSummaries();
    }

    protected override async Task OnParametersSetAsync()
    {
        await RefreshSummaries();
    }

    private async Task RefreshSummaries()
    {
        _clientSummaries = SessionMonitor.GetActiveSessionsByClient().ToList();
        _totalActiveSessions = _clientSummaries.Sum(s => s.ActiveSessionCount);
        await Task.CompletedTask;
    }

    private double GetSharePercent(int count)
    {
        if (_totalActiveSessions == 0)
        {
            return 0;
        }

        return (double)count / _totalActiveSessions * 100;
    }

    private static string GetPanelTitle(ActiveClientSessionSummary group)
    {
        var adminSuffix = group.IsAdminMonitorGroup ? " · Admin" : "";
        return $"{group.ClientLabel} · {group.ActiveSessionCount} circuits · {group.DistinctPathCount} URLs{adminSuffix}";
    }
}
