@using TheNerdCollective.Blazor.SessionMonitor
@using MudBlazor
@inject ISessionMonitorService SessionMonitor

<MudStack Spacing="1" Class="pa-1">
    <MudText Typo="Typo.caption" Color="Color.Secondary">
        @_clientSummaries.Count browsers · @_totalActiveSessions open pages
    </MudText>

    @if (IsDegradedMode)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
            Top browser clients only.
        </MudAlert>
    }

    @if (_clientSummaries.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            No active sessions at this moment.
        </MudAlert>
    }
    else
    {
        <MudSimpleTable Dense="true" Hover="true" Bordered="true" Class="mb-2">
            <thead>
                <tr>
                    <th>Browser</th>
                    <th>Active URL</th>
                    <th>Client</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var summary in _clientSummaries)
                {
                    <tr>
                        <td>
                            <MudStack Row="true" Spacing="1" Class="align-center flex-wrap">
                                <MudText Typo="Typo.body2"><b>@summary.ClientLabel</b></MudText>
                                @if (summary.IsAdminMonitorGroup)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                                        Admin
                                    </MudChip>
                                }
                                @if (BrowserChips is not null)
                                {
                                    @BrowserChips(summary)
                                }
                            </MudStack>
                        </td>
                        <td>
                            <MudStack Spacing="0">
                                @foreach (var circuit in summary.Circuits)
                                {
                                    var path = SplitPath(circuit.CurrentPath);
                                    <MudStack Row="true" Spacing="1" Class="align-center flex-wrap">
                                        <MudText Typo="Typo.body2"><b>@path.Route</b></MudText>
                                        @if (!string.IsNullOrEmpty(path.Query))
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@path.Query</MudText>
                                        }
                                        @if (circuit.IsDisconnected)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                                                Disconnected
                                            </MudChip>
                                        }
                                    </MudStack>
                                }
                            </MudStack>
                        </td>
                        <td>
                            <MudStack Row="true" Justify="Justify.FlexEnd">
                                <ClientEnvironmentChips Environment="@summary.ClientEnvironment" />
                            </MudStack>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }

    <MudButton Variant="Variant.Outlined"
               Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="RefreshSummaries">
        Refresh List
    </MudButton>
</MudStack>

@code {
    private List<ActiveClientSessionSummary> _clientSummaries = [];
    private int _totalActiveSessions;

    [Parameter] public DateTime RefreshToken { get; set; }

    [Parameter] public bool IsDegradedMode { get; set; }

    /// <summary>
    /// Optional chips rendered beside the browser label. Host-specific, not part of the general monitor.
    /// </summary>
    [Parameter] public RenderFragment<ActiveClientSessionSummary>? BrowserChips { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await RefreshSummaries();
    }

    protected override async Task OnParametersSetAsync()
    {
        await RefreshSummaries();
    }

    private async Task RefreshSummaries()
    {
        _clientSummaries = SessionMonitor.GetActiveSessionsByClient().ToList();
        _totalActiveSessions = _clientSummaries.Sum(s => s.ActiveSessionCount);
        await Task.CompletedTask;
    }

    private static (string Route, string? Query) SplitPath(string? currentPath)
    {
        if (string.IsNullOrWhiteSpace(currentPath))
        {
            return ("—", null);
        }

        var queryIndex = currentPath.IndexOf('?');
        if (queryIndex < 0)
        {
            return (currentPath, null);
        }

        var query = currentPath[(queryIndex + 1)..].Replace("&", " · ", StringComparison.Ordinal);
        return (currentPath[..queryIndex], string.IsNullOrEmpty(query) ? null : query);
    }
}
