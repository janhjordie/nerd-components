@inject NerdClipboardService Clipboard
@inject NerdDesignSystemOptions HubOptions

<MudButton Size="Size.Small"
           Variant="Variant.Outlined"
           Class="@IntentClass"
           OnClick="CopyAsync"
           ClickPropagation="false">
    @Label
</MudButton>

@code {
    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public string Label { get; set; } = "Copy";

    [Parameter]
    /// <summary>
    /// Token intent for outlined chrome. Prefer BrandChrome (readable on page-surface);
    /// PrimaryAction ContrastText is for filled buttons and fails WCAG on outlined/text.
    /// </summary>
    public string Intent { get; set; } = NerdDesignSystemUi.BrandChrome;

    private string IntentClass =>
        NerdDesignSystemUi.TokenClass(HubOptions, Intent);

    private async Task CopyAsync() => await Clipboard.CopyAsync(Text);
}
