@*
  Canonical catalog page frame. Host layouts must NOT wrap @Body in another MudContainer —
  every catalog (hub / colors / recipes / typography / playbook / WCAG) uses this width.
*@
<MudContainer MaxWidth="@MaxWidth" Class="@($"my-6 pa-4 {Class}")">
    @ChildContent
</MudContainer>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Canonical catalog width — do not override per page unless the matrix truly needs full bleed.</summary>
    [Parameter]
    public MaxWidth MaxWidth { get; set; } = MaxWidth.ExtraLarge;

    [Parameter]
    public string? Class { get; set; }
}
