@*
  Shared catalog hub menu — same BrandChrome Outlined/Filled MudButtons on every catalog page.
  Counts always come from NerdDesignSystemOptions so every page shows identical badges.
*@
@inject NerdDesignSystemOptions Options

<MudStack Row="true"
          Spacing="1"
          AlignItems="AlignItems.Center"
          Class="@($"flex-wrap {Class}")"
          data-nerd-token="@ChromeSurfaceClass"
          data-nerd-style-guard="@NerdDesignSystemUi.CatalogChromePlacement">
    <MudButton Href="@Options.HubRoute"
               Variant="@VariantFor(NerdCatalogSection.Hub)"
               Size="Size.Small"
               Class="@ChromeClass">
        Design system
    </MudButton>
    <MudButton Href="@Options.DesignTokensRoute"
               Variant="@VariantFor(NerdCatalogSection.Colors)"
               Size="Size.Small"
               Class="@ChromeClass">
        Colors@(Options.DesignTokenCount > 0 ? $" ({Options.DesignTokenCount})" : "")
    </MudButton>
    <MudButton Href="@Options.DesignTokenRecipesRoute"
               Variant="@VariantFor(NerdCatalogSection.Recipes)"
               Size="Size.Small"
               Class="@ChromeClass">
        Recipes@(Options.DesignTokenRecipeCount > 0 ? $" ({Options.DesignTokenRecipeCount})" : "")
    </MudButton>
    <MudButton Href="@Options.TypographyRoute"
               Variant="@VariantFor(NerdCatalogSection.Typography)"
               Size="Size.Small"
               Class="@ChromeClass">
        Typography
    </MudButton>
    <MudButton Href="@Options.ThemeRoute"
               Variant="@VariantFor(NerdCatalogSection.Theme)"
               Size="Size.Small"
               Class="@ChromeClass">
        Theme
    </MudButton>
    <MudButton Href="@Options.PlayBookRoute"
               Variant="@VariantFor(NerdCatalogSection.PlayBook)"
               Size="Size.Small"
               Class="@ChromeClass">
        PlayBook
    </MudButton>
    <MudButton Href="@Options.ChangelogRoute"
               Variant="@VariantFor(NerdCatalogSection.Changelog)"
               Size="Size.Small"
               Class="@ChromeClass">
        Changelog
    </MudButton>
    @if (ShowWcag)
    {
        <MudButton Href="@Options.WcagGuideRoute"
                   Variant="@VariantFor(NerdCatalogSection.Wcag)"
                   Size="Size.Small"
                   Class="@ChromeClass">
            WCAG
        </MudButton>
    }
</MudStack>

@code {
    [Parameter]
    public NerdCatalogSection Current { get; set; } = NerdCatalogSection.None;

    [Parameter]
    public bool ShowWcag { get; set; } = true;

    [Parameter]
    public string? Class { get; set; }

    private string ChromeClass =>
        NerdDesignSystemUi.TokenClass(Options.TokenPrefix, NerdDesignSystemUi.BrandChrome);

    private string ChromeSurfaceClass =>
        NerdDesignSystemUi.TokenClass(Options.TokenPrefix, NerdDesignSystemUi.PageSurface);

    private Variant VariantFor(NerdCatalogSection section) =>
        Current == section ? Variant.Filled : Variant.Outlined;
}
