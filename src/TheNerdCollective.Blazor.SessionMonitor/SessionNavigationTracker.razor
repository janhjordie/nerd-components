@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject NavigationManager Navigation
@inject SessionMonitorCircuitContext CircuitContext
@inject SessionMonitorService Monitor

@code {
  protected override void OnInitialized()
  {
    Navigation.LocationChanged += HandleLocationChanged;
    Report(Navigation.Uri);
  }

  private void HandleLocationChanged(object? sender, LocationChangedEventArgs e) => Report(e.Location);

  private void Report(string location)
  {
    if (string.IsNullOrWhiteSpace(CircuitContext.CircuitId))
    {
      return;
    }

    Monitor.UpdateCurrentPath(CircuitContext.CircuitId, SessionPathNormalizer.Normalize(location));
  }

  public void Dispose() => Navigation.LocationChanged -= HandleLocationChanged;
}
