<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>TheNerdCollective.MudComponents.DesignTokens</PackageId>
    <Version>2.2.1</Version>
    <Authors>The Nerd Collective</Authors>
    <Description>Customer-specific CSS design tokens and MudBlazor component color variants.</Description>
    <PackageTags>mudblazor;blazor;design-tokens;css;branding;colors;wcag;analyzer</PackageTags>
    <LicenseExpression>Apache-2.0</LicenseExpression>
    <RepositoryUrl>https://github.com/janhjordie/nerd-components</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheNerdCollective.DesignTokens.Core\TheNerdCollective.DesignTokens.Core.csproj" />
    <ProjectReference Include="..\TheNerdCollective.MudComponents.Shared\TheNerdCollective.MudComponents.Shared.csproj" />
    <ProjectReference Include="..\TheNerdCollective.MudComponents.DesignTokens.Analyzers\TheNerdCollective.MudComponents.DesignTokens.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer"
                      SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Include="build\TheNerdCollective.MudComponents.DesignTokens.props" Pack="true" PackagePath="build\" />
    <None Include="buildTransitive\TheNerdCollective.MudComponents.DesignTokens.props" Pack="true" PackagePath="buildTransitive\" />
    <Content Include="reference\mudblazor\**\*.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="reference\mudblazor\**\sources\COMPONENTS.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Ship NRDT001 analyzer. Avoid DependsOnTargets Build: CI packs with NoBuild after a prior build. -->
  <Target Name="PackNerdContrastAnalyzer" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <_NerdAnalyzerDll>$(MSBuildThisFileDirectory)..\TheNerdCollective.MudComponents.DesignTokens.Analyzers\bin\$(Configuration)\netstandard2.0\TheNerdCollective.MudComponents.DesignTokens.Analyzers.dll</_NerdAnalyzerDll>
    </PropertyGroup>
    <Error Condition="!Exists('$(_NerdAnalyzerDll)')"
           Text="NRDT001 analyzer DLL missing at $(_NerdAnalyzerDll). Build DesignTokens.Analyzers (Release) before packing." />
    <ItemGroup>
      <_PackageFiles Include="$(_NerdAnalyzerDll)">
        <PackagePath>analyzers/dotnet/cs</PackagePath>
      </_PackageFiles>
    </ItemGroup>
  </Target>
</Project>
