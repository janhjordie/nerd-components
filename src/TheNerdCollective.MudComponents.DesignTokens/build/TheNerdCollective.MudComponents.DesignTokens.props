<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Feed Razor markup to NRDT001 contrast analyzer. Disable with DisableNerdDesignTokenRazorContrastAnalyzer=true. -->
  <ItemGroup Condition="'$(DisableNerdDesignTokenRazorContrastAnalyzer)' != 'true'">
    <AdditionalFiles Include="**/*.razor" Condition="Exists('$(MSBuildProjectDirectory)')" />
  </ItemGroup>
</Project>
