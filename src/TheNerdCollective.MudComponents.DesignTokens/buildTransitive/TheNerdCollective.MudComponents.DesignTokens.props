<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    NRDT001 Razor contrast analyzer — ON by default for every DesignTokens consumer.
    Opt out:
      <DisableNerdDesignTokenRazorContrastAnalyzer>true</DisableNerdDesignTokenRazorContrastAnalyzer>
    Keep warnings (do not fail build):
      <NerdDesignTokenRazorContrastTreatAsError>false</NerdDesignTokenRazorContrastTreatAsError>
  -->
  <PropertyGroup>
    <EnableNerdDesignTokenRazorContrastAnalyzer Condition="'$(EnableNerdDesignTokenRazorContrastAnalyzer)' == ''">true</EnableNerdDesignTokenRazorContrastAnalyzer>
    <!-- Disable* wins when set true (back-compat). -->
    <EnableNerdDesignTokenRazorContrastAnalyzer Condition="'$(DisableNerdDesignTokenRazorContrastAnalyzer)' == 'true'">false</EnableNerdDesignTokenRazorContrastAnalyzer>
    <NerdDesignTokenRazorContrastTreatAsError Condition="'$(NerdDesignTokenRazorContrastTreatAsError)' == ''">true</NerdDesignTokenRazorContrastTreatAsError>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableNerdDesignTokenRazorContrastAnalyzer)' == 'true'">
    <AdditionalFiles Include="**/*.razor" Condition="Exists('$(MSBuildProjectDirectory)')" />
  </ItemGroup>

  <PropertyGroup Condition="'$(EnableNerdDesignTokenRazorContrastAnalyzer)' == 'true' AND '$(NerdDesignTokenRazorContrastTreatAsError)' == 'true'">
    <WarningsAsErrors>$(WarningsAsErrors);NRDT001</WarningsAsErrors>
  </PropertyGroup>
</Project>
