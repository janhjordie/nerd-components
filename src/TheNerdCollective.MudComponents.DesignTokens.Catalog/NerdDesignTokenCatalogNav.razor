@using TheNerdCollective.MudComponents.Shared

@*
  Backward-compatible wrapper — prefer NerdCatalogHubNav / NerdCatalogPageHeader.
*@
<NerdCatalogHubNav Current="@(Current switch
                         {
                             "recipes" => NerdCatalogSection.Recipes,
                             "colors" => NerdCatalogSection.Colors,
                             _ => NerdCatalogSection.Colors
                         })"
                   ColorCount="Options.Colors.Count"
                   RecipeCount="Options.Recipes.Count" />

@code {
    [Parameter, EditorRequired]
    public NerdDesignTokenOptions Options { get; set; } = default!;

    [Parameter, EditorRequired]
    public NerdDesignSystemOptions HubOptions { get; set; } = default!;

    [Parameter]
    public string Current { get; set; } = "colors";
}
