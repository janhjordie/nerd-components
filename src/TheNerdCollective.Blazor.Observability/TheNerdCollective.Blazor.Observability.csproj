<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TheNerdCollective.Blazor.Observability</RootNamespace>
    <AssemblyName>TheNerdCollective.Blazor.Observability</AssemblyName>
    <PackageId>TheNerdCollective.Blazor.Observability</PackageId>
    <Version>1.1.1</Version>
    <Authors>The Nerd Collective</Authors>
    <Description>Backend-agnostic observability dashboard services for Blazor Server apps. IObservabilityBackend abstraction, minimal API endpoints, and OpenTelemetry-friendly panel presets.</Description>
    <PackageTags>blazor;observability;opentelemetry;signoz;metrics;dashboard</PackageTags>
    <License>Apache-2.0</License>
    <LicenseExpression>Apache-2.0</LicenseExpression>
    <RepositoryUrl>https://github.com/janhjordie/TheNerdCollective.Components</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
