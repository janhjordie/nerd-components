@namespace TheNerdCollective.Blazor.ReCaptcha
@inject INerdReCaptchaVerifier Verifier
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="nerd-recaptcha" data-testid="nerd-recaptcha" data-mode="@Mode.ToString().ToLowerInvariant()">
    @if (Mode == NerdReCaptchaMode.GoogleV2)
    {
        <div @ref="_widgetHost" class="nerd-recaptcha-google" data-testid="nerd-recaptcha-google"></div>
        @if (!string.IsNullOrWhiteSpace(DisplayError))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2" data-testid="nerd-recaptcha-error">@DisplayError</MudAlert>
        }
    }
    else if (Mode == NerdReCaptchaMode.GoogleEnterprise)
    {
        <div @ref="_widgetHost"
             class="nerd-recaptcha-enterprise"
             data-testid="nerd-recaptcha-enterprise"
             aria-live="polite"></div>
        @if (!string.IsNullOrWhiteSpace(DisplayError))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2" data-testid="nerd-recaptcha-error">@DisplayError</MudAlert>
        }
    }
    else if (_challenge is not null)
    {
        <MudPaper Outlined="true"
                  Elevation="0"
                  Class="pa-4 nerd-recaptcha-simple"
                  data-testid="nerd-recaptcha-simple">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudAvatar Color="Color.Primary" Size="MudBlazor.Size.Medium" Variant="Variant.Filled">
                            <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" />
                        </MudAvatar>
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle1">@SimpleTitle</MudText>
                            @if (!string.IsNullOrWhiteSpace(HintLabel))
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@HintLabel</MudText>
                            }
                        </MudStack>
                    </MudStack>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               Size="MudBlazor.Size.Small"
                               StartIcon="@Icons.Material.Outlined.Refresh"
                               OnClick="RefreshSimpleChallengeAsync"
                               aria-label="@RefreshLabel"
                               data-testid="nerd-recaptcha-simple-refresh">
                        @RefreshLabel
                    </MudButton>
                </MudStack>

                <MudDivider />

                <MudStack Spacing="2">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@ChallengeLabel</MudText>
                    <MudText Typo="Typo.h5" data-testid="nerd-recaptcha-simple-prompt">@_challenge.Prompt</MudText>
                    <MudTextField T="string"
                                  Value="_answerText"
                                  ValueChanged="OnAnswerTextChangedAsync"
                                  Label="@AnswerLabel"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Text"
                                  InputMode="InputMode.numeric"
                                  Immediate="true"
                                  FullWidth="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Outlined.Calculate"
                                  data-testid="nerd-recaptcha-simple-answer" />
                </MudStack>

                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" data-testid="nerd-recaptcha-error">@ErrorMessage</MudAlert>
                }
            </MudStack>
        </MudPaper>
    }
    <input type="hidden" name="@TokenInputName" value="@Token" />
</div>

@code {
    // BacklogTrace: NC-feature-feedback-captcha
    private ElementReference _widgetHost;
    private IJSObjectReference? _module;
    private DotNetObjectReference<NerdReCaptcha>? _dotNetRef;
    private SimpleChallenge? _challenge;
    private string _answerText = "";
    private bool _googleRendered;
    private bool _disposed;
    private string? _runtimeError;

    [Parameter]
    public string? Token { get; set; }

    [Parameter]
    public EventCallback<string?> TokenChanged { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public string Theme { get; set; } = "light";

    /// <summary>Google reCAPTCHA widget size (<c>normal</c> or <c>compact</c>).</summary>
    [Parameter]
    public string Size { get; set; } = "normal";

    [Parameter]
    public string SimpleTitle { get; set; } = "Quick verification";

    [Parameter]
    public string RefreshLabel { get; set; } = "New challenge";

    [Parameter]
    public string HintLabel { get; set; } = "";

    [Parameter]
    public string ChallengeLabel { get; set; } = "Solve this to continue";

    [Parameter]
    public string AnswerLabel { get; set; } = "Your answer";

    private NerdReCaptchaMode Mode => Verifier.Mode;

    protected override async Task OnInitializedAsync()
    {
        if (Mode == NerdReCaptchaMode.Simple)
        {
            await RefreshSimpleChallengeAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Mode is not (NerdReCaptchaMode.GoogleV2 or NerdReCaptchaMode.GoogleEnterprise)
            || _googleRendered)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(Verifier.SiteKey))
        {
            return;
        }

        _module ??= await JS.InvokeAsync<IJSObjectReference>(
            "import",
            "./_content/TheNerdCollective.Blazor.ReCaptcha/js/nerd-recaptcha.js");
        _dotNetRef ??= DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync(
            "render",
            _widgetHost,
            Verifier.SiteKey,
            Theme,
            Size,
            _dotNetRef,
            Mode == NerdReCaptchaMode.GoogleEnterprise,
            ExpectedAction,
            TokenInputName);
        _googleRendered = true;
    }

    public async Task<string?> GenerateTokenAsync()
    {
        if (Mode != NerdReCaptchaMode.GoogleEnterprise)
        {
            return Token;
        }

        if (_module is null || string.IsNullOrWhiteSpace(Verifier.SiteKey))
        {
            _runtimeError = "Google reCAPTCHA er ikke klar endnu. Prøv igen.";
            await InvokeAsync(StateHasChanged);
            return null;
        }

        try
        {
            var token = await _module.InvokeAsync<string>(
                "execute",
                _widgetHost,
                Verifier.SiteKey,
                ExpectedAction);
            _runtimeError = null;
            await SetTokenAsync(token);
            await InvokeAsync(StateHasChanged);
            return token;
        }
        catch (JSException)
        {
            _runtimeError = "Google reCAPTCHA kunne ikke bekræfte formularen. Prøv igen.";
            await SetTokenAsync(null);
            await InvokeAsync(StateHasChanged);
            return null;
        }
    }

    [Parameter]
    public string TokenInputName { get; set; } = "captchaToken";

    private string ExpectedAction => Verifier.Action ?? "submit";

    private string? DisplayError => ErrorMessage ?? _runtimeError;

    [JSInvokable]
    public async Task OnGoogleTokenAsync(string token)
    {
        if (_disposed) return;
        _runtimeError = null;
        await SetTokenAsync(token);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnGoogleExpiredAsync()
    {
        if (_disposed) return;
        await SetTokenAsync(null);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnGoogleErrorAsync()
    {
        if (_disposed) return;
        _runtimeError = "Google reCAPTCHA kunne ikke bekræfte formularen. Prøv igen.";
        await SetTokenAsync(null);
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshSimpleChallengeAsync()
    {
        _challenge = await Verifier.CreateSimpleChallengeAsync();
        _answerText = "";
        await SetTokenAsync(null);
    }

    private Task OnAnswerTextChangedAsync(string value)
    {
        _answerText = value ?? "";
        return PublishAnswerTokenAsync();
    }

    private Task PublishAnswerTokenAsync()
    {
        if (_challenge is null || string.IsNullOrWhiteSpace(_answerText))
        {
            return SetTokenAsync(null);
        }

        return SetTokenAsync($"simple:{_challenge.ChallengeId}:{_answerText.Trim()}");
    }

    private async Task SetTokenAsync(string? token)
    {
        if (Token == token)
        {
            return;
        }

        Token = token;
        await TokenChanged.InvokeAsync(token);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("detach", _widgetHost);
            }
            catch (JSDisconnectedException)
            {
                // Circuit gone — JavaScript listener is no longer relevant.
            }
        }

        _dotNetRef?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit gone — ignore.
            }
        }
    }
}
