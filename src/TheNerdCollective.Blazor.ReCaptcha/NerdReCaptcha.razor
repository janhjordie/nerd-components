@namespace TheNerdCollective.Blazor.ReCaptcha
@using Microsoft.Extensions.Logging
@inject INerdReCaptchaVerifier Verifier
@inject IJSRuntime JS
@inject ILogger<NerdReCaptcha> Logger
@implements IAsyncDisposable

<div class="nerd-recaptcha" data-testid="nerd-recaptcha" data-mode="@Mode.ToString().ToLowerInvariant()">
    @if (Mode == NerdReCaptchaMode.GoogleV2 && !_useSimpleFallback)
    {
        <div @ref="_widgetHost" class="nerd-recaptcha-google" data-testid="nerd-recaptcha-google"></div>
        <button type="button"
                class="nerd-recaptcha__fallback-button"
                @onclick="ActivateSimpleFallbackAsync"
                data-testid="nerd-recaptcha-use-simple-fallback">
            Brug regneopgaven i stedet
        </button>
        @if (!string.IsNullOrWhiteSpace(DisplayError))
        {
            <div class="nerd-recaptcha__error" role="alert" data-testid="nerd-recaptcha-error">@DisplayError</div>
        }
    }
    else if (Mode == NerdReCaptchaMode.GoogleEnterprise && !_useSimpleFallback)
    {
        <div @ref="_widgetHost"
             class="nerd-recaptcha-enterprise"
             data-testid="nerd-recaptcha-enterprise"
             aria-live="polite"></div>
        <button type="button"
                class="nerd-recaptcha__fallback-button"
                @onclick="ActivateSimpleFallbackAsync"
                data-testid="nerd-recaptcha-use-simple-fallback">
            Brug regneopgaven i stedet
        </button>
        @if (!string.IsNullOrWhiteSpace(DisplayError))
        {
            <div class="nerd-recaptcha__error" role="alert" data-testid="nerd-recaptcha-error">@DisplayError</div>
        }
    }
    else if (_challenge is not null)
    {
        <div class="nerd-recaptcha-simple" data-testid="nerd-recaptcha-simple">
            <div class="nerd-recaptcha-simple__header">
                <div class="nerd-recaptcha-simple__identity">
                    <span class="nerd-recaptcha-simple__avatar" aria-hidden="true">✓</span>
                    <div>
                        <div class="nerd-recaptcha-simple__title">@SimpleTitle</div>
                        @if (!string.IsNullOrWhiteSpace(HintLabel))
                        {
                            <div class="nerd-recaptcha-simple__hint">@HintLabel</div>
                        }
                    </div>
                </div>
                <button type="button"
                        class="nerd-recaptcha-simple__refresh"
                        @onclick="RefreshSimpleChallengeAsync"
                        aria-label="@RefreshLabel"
                        data-testid="nerd-recaptcha-simple-refresh">
                    <span aria-hidden="true">↻</span>
                    @RefreshLabel
                </button>
            </div>

            <hr class="nerd-recaptcha-simple__divider" />

            <div class="nerd-recaptcha-simple__challenge">
                <div class="nerd-recaptcha-simple__label">@ChallengeLabel</div>
                <div class="nerd-recaptcha-simple__prompt" data-testid="nerd-recaptcha-simple-prompt">@_challenge.Prompt</div>
                <label class="nerd-recaptcha-simple__input-label" for="@AnswerInputId">@AnswerLabel</label>
                <input id="@AnswerInputId"
                       class="nerd-recaptcha-simple__input"
                       value="@_answerText"
                       @oninput="OnAnswerInputChanged"
                       inputmode="numeric"
                       autocomplete="off"
                       data-testid="nerd-recaptcha-simple-answer" />
            </div>

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="nerd-recaptcha__error" role="alert" data-testid="nerd-recaptcha-error">@ErrorMessage</div>
            }
        </div>
    }
    <input type="hidden" name="@TokenInputName" value="@Token" />
</div>

@code {
    // BacklogTrace: NC-feature-feedback-captcha
    private ElementReference _widgetHost;
    private IJSObjectReference? _module;
    private DotNetObjectReference<NerdReCaptcha>? _dotNetRef;
    private SimpleChallenge? _challenge;
    private string _answerText = "";
    private bool _googleRendered;
    private bool _disposed;
    private bool _useSimpleFallback;
    private string? _runtimeError;
    private string AnswerInputId { get; } = $"nerd-recaptcha-answer-{Guid.NewGuid():N}";

    [Parameter]
    public string? Token { get; set; }

    [Parameter]
    public EventCallback<string?> TokenChanged { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public bool UseSimpleFallback { get; set; }

    [Parameter]
    public EventCallback SimpleFallbackActivated { get; set; }

    [Parameter]
    public string Theme { get; set; } = "light";

    /// <summary>Google reCAPTCHA widget size (<c>normal</c> or <c>compact</c>).</summary>
    [Parameter]
    public string Size { get; set; } = "normal";

    [Parameter]
    public string SimpleTitle { get; set; } = "Bekræft, at du er et menneske";

    [Parameter]
    public string RefreshLabel { get; set; } = "Ny opgave";

    [Parameter]
    public string HintLabel { get; set; } = "";

    [Parameter]
    public string ChallengeLabel { get; set; } = "Regn opgaven ud, og skriv summen i feltet";

    [Parameter]
    public string AnswerLabel { get; set; } = "Skriv summen her";

    private NerdReCaptchaMode Mode => Verifier.Mode;

    protected override async Task OnInitializedAsync()
    {
        _useSimpleFallback = UseSimpleFallback || Mode == NerdReCaptchaMode.Simple;
        if (_useSimpleFallback)
        {
            await RefreshSimpleChallengeAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (UseSimpleFallback && !_useSimpleFallback)
        {
            await ActivateSimpleFallbackAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (UseSimpleFallback
            || _useSimpleFallback
            || Mode is not (NerdReCaptchaMode.GoogleV2 or NerdReCaptchaMode.GoogleEnterprise)
            || _googleRendered)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(Verifier.SiteKey))
        {
            return;
        }

        try
        {
            if (UseSimpleFallback || _useSimpleFallback)
            {
                return;
            }

            _module ??= await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/TheNerdCollective.Blazor.ReCaptcha/js/nerd-recaptcha.js");
            _dotNetRef ??= DotNetObjectReference.Create(this);

            if (UseSimpleFallback || _useSimpleFallback)
            {
                return;
            }

            await _module.InvokeVoidAsync(
                "render",
                _widgetHost,
                Verifier.SiteKey,
                Theme,
                Size,
                _dotNetRef,
                Mode == NerdReCaptchaMode.GoogleEnterprise,
                ExpectedAction,
                TokenInputName);
            _googleRendered = true;
        }
        catch (JSException)
        {
            Logger.LogWarning("Google reCAPTCHA could not initialize; using the simple challenge fallback.");
            _runtimeError = null;
            await ActivateSimpleFallbackAsync();
        }
    }

    private async Task ActivateSimpleFallbackAsync()
    {
        if (_useSimpleFallback || _disposed)
        {
            return;
        }

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("detach", _widgetHost);
            }
            catch (JSException)
            {
                Logger.LogWarning("Could not detach the failed Google reCAPTCHA widget before switching to the simple challenge.");
            }
        }

        _useSimpleFallback = true;
        _googleRendered = false;
        _runtimeError = null;
        await RefreshSimpleChallengeAsync();
        await SimpleFallbackActivated.InvokeAsync();
        await InvokeAsync(StateHasChanged);
    }

    public async Task<string?> GenerateTokenAsync()
    {
        if (_useSimpleFallback || Mode != NerdReCaptchaMode.GoogleEnterprise)
        {
            return Token;
        }

        if (_module is null || string.IsNullOrWhiteSpace(Verifier.SiteKey))
        {
            _runtimeError = "Google reCAPTCHA er ikke klar endnu. Prøv igen.";
            await InvokeAsync(StateHasChanged);
            return null;
        }

        try
        {
            var token = await _module.InvokeAsync<string>(
                "execute",
                _widgetHost,
                Verifier.SiteKey,
                ExpectedAction);
            _runtimeError = null;
            await SetTokenAsync(token);
            await InvokeAsync(StateHasChanged);
            return token;
        }
        catch (JSException)
        {
            _runtimeError = "Google reCAPTCHA kunne ikke bekræfte formularen. Prøv igen.";
            await SetTokenAsync(null);
            await InvokeAsync(StateHasChanged);
            return null;
        }
    }

    [Parameter]
    public string TokenInputName { get; set; } = "captchaToken";

    private string ExpectedAction => Verifier.Action ?? "submit";

    private string? DisplayError => ErrorMessage ?? _runtimeError;

    [JSInvokable]
    public async Task OnGoogleTokenAsync(string token)
    {
        if (_disposed) return;
        _runtimeError = null;
        await SetTokenAsync(token);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnGoogleExpiredAsync()
    {
        if (_disposed) return;
        await SetTokenAsync(null);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnGoogleErrorAsync()
    {
        if (_disposed) return;
        await ActivateSimpleFallbackAsync();
    }

    private async Task RefreshSimpleChallengeAsync()
    {
        _challenge = await Verifier.CreateSimpleChallengeAsync();
        _answerText = "";
        await SetTokenAsync(null);
    }

    private Task OnAnswerInputChanged(ChangeEventArgs args)
    {
        return OnAnswerTextChangedAsync(args.Value?.ToString() ?? "");
    }

    private Task OnAnswerTextChangedAsync(string value)
    {
        _answerText = value ?? "";
        return PublishAnswerTokenAsync();
    }

    private Task PublishAnswerTokenAsync()
    {
        if (_challenge is null || string.IsNullOrWhiteSpace(_answerText))
        {
            return SetTokenAsync(null);
        }

        return SetTokenAsync($"simple:{_challenge.ChallengeId}:{_answerText.Trim()}");
    }

    private async Task SetTokenAsync(string? token)
    {
        if (Token == token)
        {
            return;
        }

        Token = token;
        await TokenChanged.InvokeAsync(token);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("detach", _widgetHost);
            }
            catch (JSDisconnectedException)
            {
                // Circuit gone — JavaScript listener is no longer relevant.
            }
        }

        _dotNetRef?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit gone — ignore.
            }
        }
    }
}
