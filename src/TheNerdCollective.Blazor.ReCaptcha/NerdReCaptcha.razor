@namespace TheNerdCollective.Blazor.ReCaptcha
@inject INerdReCaptchaVerifier Verifier
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="nerd-recaptcha" data-testid="nerd-recaptcha" data-mode="@Mode.ToString().ToLowerInvariant()">
    @if (Mode == NerdReCaptchaMode.GoogleV2)
    {
        <div @ref="_widgetHost" class="nerd-recaptcha-google" data-testid="nerd-recaptcha-google"></div>
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2" data-testid="nerd-recaptcha-error">@ErrorMessage</MudAlert>
        }
    }
    else if (_challenge is not null)
    {
        <MudPaper Outlined="true"
                  Elevation="0"
                  Class="pa-3 nerd-recaptcha-simple"
                  data-testid="nerd-recaptcha-simple">
            <MudStack Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" Color="Color.Primary" />
                        <MudText Typo="Typo.subtitle2">@SimpleTitle</MudText>
                    </MudStack>
                    <MudTooltip Text="@RefreshLabel">
                        <MudIconButton Icon="@Icons.Material.Outlined.Refresh"
                                       Color="Color.Primary"
                                       Size="MudBlazor.Size.Small"
                                       aria-label="@RefreshLabel"
                                       OnClick="RefreshSimpleChallengeAsync"
                                       data-testid="nerd-recaptcha-simple-refresh" />
                    </MudTooltip>
                </MudStack>

                <MudTextField @bind-Value="_answerText"
                              @bind-Value:after="OnAnswerChangedAsync"
                              Label="@_challenge.Prompt"
                              Variant="Variant.Outlined"
                              InputType="InputType.Number"
                              InputMode="InputMode.numeric"
                              Immediate="true"
                              FullWidth="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Calculate"
                              HelperText="@HintLabel"
                              data-testid="nerd-recaptcha-simple-answer" />

                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" data-testid="nerd-recaptcha-error">@ErrorMessage</MudAlert>
                }
            </MudStack>
        </MudPaper>
    }
</div>

@code {
    private ElementReference _widgetHost;
    private IJSObjectReference? _module;
    private DotNetObjectReference<NerdReCaptcha>? _dotNetRef;
    private SimpleChallenge? _challenge;
    private string _answerText = "";
    private bool _googleRendered;

    [Parameter]
    public string? Token { get; set; }

    [Parameter]
    public EventCallback<string?> TokenChanged { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public string Theme { get; set; } = "light";

    /// <summary>Google reCAPTCHA widget size (<c>normal</c> or <c>compact</c>).</summary>
    [Parameter]
    public string Size { get; set; } = "normal";

    [Parameter]
    public string SimpleTitle { get; set; } = "Quick verification";

    [Parameter]
    public string RefreshLabel { get; set; } = "New challenge";

    [Parameter]
    public string HintLabel { get; set; } = "Simple challenge — Google reCAPTCHA is not configured.";

    private NerdReCaptchaMode Mode => Verifier.Mode;

    protected override async Task OnInitializedAsync()
    {
        if (Mode == NerdReCaptchaMode.Simple)
        {
            await RefreshSimpleChallengeAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Mode != NerdReCaptchaMode.GoogleV2 || _googleRendered)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(Verifier.SiteKey))
        {
            return;
        }

        _module ??= await JS.InvokeAsync<IJSObjectReference>(
            "import",
            "./_content/TheNerdCollective.Blazor.ReCaptcha/js/nerd-recaptcha.js");
        _dotNetRef ??= DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync(
            "render",
            _widgetHost,
            Verifier.SiteKey,
            Theme,
            Size,
            _dotNetRef);
        _googleRendered = true;
    }

    [JSInvokable]
    public async Task OnGoogleTokenAsync(string token)
    {
        Token = token;
        await TokenChanged.InvokeAsync(token);
    }

    [JSInvokable]
    public async Task OnGoogleExpiredAsync()
    {
        Token = null;
        await TokenChanged.InvokeAsync(null);
    }

    private async Task RefreshSimpleChallengeAsync()
    {
        _challenge = await Verifier.CreateSimpleChallengeAsync();
        _answerText = "";
        Token = null;
        await TokenChanged.InvokeAsync(null);
    }

    private async Task OnAnswerChangedAsync()
    {
        if (_challenge is null || string.IsNullOrWhiteSpace(_answerText))
        {
            Token = null;
            await TokenChanged.InvokeAsync(null);
            return;
        }

        Token = $"simple:{_challenge.ChallengeId}:{_answerText.Trim()}";
        await TokenChanged.InvokeAsync(Token);
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit gone — ignore.
            }
        }
    }
}
